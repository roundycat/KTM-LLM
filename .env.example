# ─────────────────────────────────────────────────────────────
# 글로벌(OpenAI) 모델 — 평가 + 파인튜닝
# ─────────────────────────────────────────────────────────────
# OpenAI API 키 (필수: 글로벌 모델 평가/파인튜닝)
OPENAI_API_KEY=sk-...

# (선택) 파인튜닝/평가에 사용할 베이스 모델 ID 오버라이드.
# 비워두면 training/config.py 의 기본값을 사용합니다.
# - 파인튜닝 가능 스냅샷 예시: gpt-4o-2024-08-06, gpt-4.1-2025-04-14, gpt-4o-mini-2024-07-18
# - GPT-5 계열은 계정 권한에 따라 모델 ID/파인튜닝 가능 여부가 다릅니다. 콘솔에서 확인 후 입력하세요.
GPT4_MODEL=gpt-4o-2024-08-06
GPT5_MODEL=gpt-5

# (선택) 파인튜닝 완료 후 생성된 모델 ID를 여기에 넣으면 evaluate.py 가 함께 평가합니다.
GPT4_FINETUNED_MODEL=
GPT5_FINETUNED_MODEL=

# ─────────────────────────────────────────────────────────────
# 로컬(한국형) 모델 — Ollama 의 OpenAI 호환 엔드포인트로 평가
# ─────────────────────────────────────────────────────────────
# Ollama 설치 후 `ollama pull exaone3.5:7.8b` 로 모델을 받으세요.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama
# `ollama list` 에 보이는 태그와 일치해야 합니다.
LOCAL_MODEL=exaone3.5:7.8b
