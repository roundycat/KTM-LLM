# --- 비밀키 ---
.env
*.key

# --- 대용량 원본/중간 산출물 (레포에 올리지 않음) ---
raw/
img/
tiles/
_*.py
_*.png

# --- 세션/도구 로컬 설정 ---
.claude/

# --- 파인튜닝/평가 산출물 ---
# 주의: 아래 두 경로는 의도적으로 레포에 '포함'되어 추적 중이다(재현·논문 부록용).
#   - data/finetune_*.jsonl : SFT 변환 데이터(기출/용어 train·val 4종)
#   - results/              : 모델별 평가 결과 JSON(논문 결과 원자료)
# 따라서 무시 규칙을 두지 않는다(이전에는 무시로 선언했으나 force-add 되어 있어
# 선언과 실제가 어긋났다 → 실제 추적 상태에 맞춰 규칙 제거). 산출물을 다시 무시하려면
# 먼저 `git rm --cached -r results data/finetune_*.jsonl` 후 아래 패턴을 복원할 것.

# --- Python ---
__pycache__/
*.pyc
.venv/
venv/
.python-version

# --- OS / 에디터 ---
.DS_Store
Thumbs.db
.vscode/
.idea/
